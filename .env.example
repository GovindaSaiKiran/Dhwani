# ==============================================================================
# Dhwani - Pan-Indian Autonomous Voice OS Environment Configuration
# ==============================================================================

# LLM Providers (OpenRouter / OpenAI / Gemini)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# GEMINI_API_KEY=your_gemini_api_key_here

# Gnani.ai Voice Pipeline (Prisma v3.0 STT & Timbre v3.0 TTS)
# Sign up at https://gnani.ai to get your API key for Indian languages
GNANI_API_KEY=your_gnani_api_key_here

# Android ADB Configuration
ADB_HOST=127.0.0.1
ADB_PORT=5037
TARGET_DEVICE_SERIAL=RZGL52YX8DD

# Artemis Autonomous Agent Execution Settings
ARTEMIS_DEFAULT_PROFILE=flash
ARTEMIS_KEEP_DEVICE_AWAKE=true
ARTEMIS_HIERARCHY_BACKEND=auto
ARTEMIS_HELPER_AUTO_INSTALL=false
